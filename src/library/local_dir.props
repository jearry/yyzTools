<?xml version="1.0" encoding="utf-8"?>
<!--
  Local developer overrides. This file is machine-specific: fill in your
  own paths below (e.g. third-party SDK locations). Keep it out of version
  control or keep the values as empty placeholders for a fresh checkout.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
	<DIRECTX_DIR></DIRECTX_DIR>
  </PropertyGroup>
  <PropertyGroup>
    <IncludePath>$(VC_IncludePath);$(WindowsSDK_IncludePath);</IncludePath>
    <LibraryPath>$(VC_LibraryPath_x86);$(WindowsSDK_LibraryPath_x86);$(NETFXKitsDir)Lib\um\x86</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup />
  <ItemGroup>
	<BuildMacro Include="DIRECTX_DIR">
      <Value>$(DIRECTX_DIR)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
  </ItemGroup>
</Project>
